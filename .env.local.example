# Copia este archivo a .env.local y completa el valor real.
# Endpoint del formulario de contacto en https://formspree.io (forma: https://formspree.io/f/xxxxxxx)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Dominio real de producción (sin slash final), usado en meta tags Open Graph/Twitter.
# Mientras no exista, el sitio usa el placeholder https://mimo.example.com.
# recuerda también actualizar public/robots.txt y public/sitemap.xml cuando lo definas.
NEXT_PUBLIC_SITE_URL=
